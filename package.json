{
  "name": "meld-clients-core",
  "version": "2.0.0",
  "description": "Music Encoding and Linked Data (MELD) clients core library",
  "repository": "git@github.com:oerc-music/meld-clients-core.git",
  "scripts": {
    "build": "babel src --out-dir lib --delete-dir-on-start --ignore \"src/**/__tests__\"",
    "build-dev": "babel src --out-dir lib --source-maps inline --delete-dir-on-start --ignore \"src/**/__tests__\"",
    "test": "jest",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/src/**/__tests__/**/*.test.js"]
  },
  "author": "David M. Weigl, David Lewis, Oxford e-Research Centre, University of Oxford",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "babel-jest": "^30.5.2",
    "chai": "^3.5.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^8.1.0",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-3d-carousel": "oerc-music/react-3d-carousel",
    "react-dom": ">=16.8.0",
    "react-media-player": "^0.7.9",
    "react-redux": ">=7.2.0",
    "react-router": ">=5.2.0",
    "redux": ">=4.0.5",
    "redux-thunk": ">=2.3.0"
  },
  "peerDependenciesMeta": {
    "react-3d-carousel": {
      "optional": true
    },
    "react-media-player": {
      "optional": true
    }
  },
  "dependencies": {
    "immutability-helper": "^2.1.2",
    "jsonld": "^5.0.0",
    "jsum": "^0.1.4",
    "leaflet": "^1.2.0",
    "n3": "^1.0.3",
    "querystring": "^0.2.0",
    "redux-promise": "^0.6.0",
    "uuid": "^8.3.2"
  }
}
